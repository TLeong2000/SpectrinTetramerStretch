#
#

# variable dispRatio universe 1.00 0.95 0.90 0.85 0.80 0.75 0.70 0.65 0.60 0.55 0.50 0.45 0.40 0.35 0.30 0.25 0.20 0.15 0.10 0.05
# variable dispRatio universe 0.05
 variable dispRatio universe 0.01 0.02 0.03 0.04
# variable dispRatio universe 0.96 0.97 0.98 0.99
# variable dispRatio universe 0.16 0.17 0.18 0.19
# variable dispRatio universe 0.05 0.10 0.15 0.20 0.25 0.30 0.35 0.40 0.45 0.50 0.55 0.60 0.65 0.70 0.75 0.80 0.85 0.90 0.95 1.0

log out_restrained/log_HarmonicRestraintStretch.${dispRatio}.lammps
print "The current dispRatio value is: ${dispRatio}"

variable totLength equal 1121.3409 # Sum of all bond equilibrium lengths
variable commDist equal "v_totLength*v_dispRatio"
variable dispDist equal "v_commDist/2"
# Displacement distance is divided by two because I want to displace both the bow and stern atoms of each chain.

variable seed equal 1
units real
boundary p p p

atom_style molecular

lattice sc 24000

# Use below with 32 processors for 4 x 2 x 4 MPI grid
# region main block -1.5 2.5 -0.5 1.5 -1.5 2.5 units lattice
# region insertionVolume block -1 2 0 1 -1 2 units lattice
#

# Use below with 8 processors for 2 x 2 x 2 MPI grid
# region main block -1 1 -1 1 -1 1 units lattice
# region insertionVolume block -0.5 0.5 -0.5 0.5 -0.5 0.5 units lattice
#

# Use below with 8 processors for 2 x 2 x 2 MPI grid
 region main block -0.5 1.5 -0.5 1.5 -0.5 1.5 units lattice
 region insertionVolume block 0 1 0 1 0 1 units lattice
#

# Use below with 18 processors for 3 x 2 x 3 MPI grid
# region main block -1.5 1.5 -0.5 1.5 -1.5 1.5 units lattice
# region insertionVolume block -1 1 0 1 -1 1 units lattice
#

# Use below with 1 processor
# region main block -0.5 0.5 -0.5 0.5 -0.5 0.5 units lattice
# region insertionVolume block 0 0 0 0 0 0 units lattice


# region main block -25000 25000 -25000 25000 -25000 25000
create_box 42 main bond/types 41 angle/types 40 extra/bond/per/atom 2 extra/angle/per/atom 3 extra/special/per/atom 6
# region insertionVolume block -15000 15000 -15000 15000 -15000 15000

# molecule productionIdealized productionIdealized.txt
#
# I am going to use a pre-minimized model for each dispRatio
#
molecule productionIdealized rest_prod_mds/restrained_production_${dispRatio}.txt
bond_style harmonic
angle_style harmonic
# Uncomment below if using dispRatio 0.00 OR if NOT using INTEL package
# 
# pair_style none

# Uncomment below if using INTEL package AND NOT using dispRatio 0.00
# 
pair_style lj/cut 0
pair_coeff * * 0 0

# create_atoms spawns in molecules on each lattice point of region insertionVolume
# such that the center of geometry of a given molecule is located at the
# lattice point assigned to said molecule
# This is not exactly what we desire for most optimal performance, but there
# is a way to get around that
 create_atoms 0 region insertionVolume mol productionIdealized ${seed} rotate 0 0 0 1

# create_atoms 0 single 0 0 -1 mol productionIdealized ${seed} rotate 0 0 0 1
# create_atoms 0 single 0 1 -1 mol productionIdealized ${seed} rotate 0 0 0 1
# create_atoms 0 single 0 0 0 mol productionIdealized ${seed} rotate 0 0 0 1
# create_atoms 0 single 0 1 0 mol productionIdealized ${seed} rotate 0 0 0 1
# create_atoms 0 single 0 0 1 mol productionIdealized ${seed} rotate 0 0 0 1
# create_atoms 0 single 0 1 1 mol productionIdealized ${seed} rotate 0 0 0 1

read_data IdealizedCoeffs.data add merge

group firstAtoms type 1
group lastAtoms type 42

group endpoints union firstAtoms lastAtoms
group internals subtract all endpoints

group molOne molecule 1
group firstOne intersect firstAtoms molOne
group lastOne intersect lastAtoms molOne

# Because the models are pre-minimized, the endpoints are pre-displaced
# We are going to bring the endpoints back together temporarily
# to prepare each molecule for recentering
 displace_atoms firstAtoms move 0 -${dispDist} 0  units box
 displace_atoms lastAtoms move  0 ${dispDist} 0  units box


 variable napmol equal $(count(molOne))

 compute xsumOne molOne reduce sum x
 compute ysumOne molOne reduce sum y
 compute zsumOne molOne reduce sum z

 compute xfirstOne firstOne reduce sum x
 compute yfirstOne firstOne reduce sum y
 compute zfirstOne firstOne reduce sum z

 run 0

# For any atom, the difference in the position of that atom with the position
# of the lattice point associated with the molecule it belongs to
# is the same across all molecules
 variable xcenterOne equal $(c_xsumOne/v_napmol)
 variable ycenterOne equal $(c_ysumOne/v_napmol)
 variable zcenterOne equal $(c_zsumOne/v_napmol)


 variable xoffset equal $(v_xcenterOne - c_xfirstOne)
 variable yoffset equal $(v_ycenterOne - c_yfirstOne)
 variable zoffset equal $(v_zcenterOne - c_zfirstOne)

# We translate all atoms so that the endpoints, before stretching,
# are located at the center of each lattice point,
# which, given how I set up the regions main and insertionVolume,
# is equal to the center of each of the 32 processor subdomains
 displace_atoms all move v_xoffset v_yoffset v_zoffset units box

# We now re-displace the endpoints
 displace_atoms firstAtoms move 0  ${dispDist} 0  units box
 displace_atoms lastAtoms move  0 -${dispDist} 0  units box

# pair_style lj/cut 0
# pair_coeff * * 0 0

write_dump all custom out_restrained/initPos.${dispRatio}.txt id mol x y z modify sort id
# write_dump all image images/init_restrained.${dispRatio}.png type type zoom 4 adiam 15.0 bond atom 5.0 size 1280 1280


 fix restraint all arclengthrestraint productionIdealized 0.25 ${totLength}

reset_timestep 0

# Set up dynamics
velocity internals create 310.0 ${seed} dist gaussian

timestep 0.001
fix integrate internals nvt temp 310.0 310.0 $(25.0*dt)

compute internalsTemp internals temp
thermo 1000000
thermo_style custom step c_internalsTemp

# compute force in y direction on one of the endpoints
# as the y direction is the direction of displacement
compute endForce lastAtoms reduce ave fy

 compute batomIDs all property/local batom1 batom2
 compute distCalc all bond/local dist dx dy dz

run 0
velocity internals scale 310.0

# fix printCenters all ave/time 100 100000 10000000 c_endForce file out_restrained/timeAvg_sternForces.${dispRatio}.txt
 dump diagnoseDist all local 1 out_restrained/diagnoseDist.${dispRatio}.txt c_batomIDs[*] c_distCalc[*]
 dump diagnoseNaN molOne custom 1 out_restrained/diagnose_NaN.${dispRatio}.txt id x y z fx fy fz
 dump_modify diagnoseNaN sort id

neighbor 100.0 bin 
comm_modify cutoff 100
neigh_modify every 1000000 delay 1000000 check yes exclude molecule/inter all

 run 2
# run 10000000

clear

next dispRatio
# jump IdealizedStretch.lammps
