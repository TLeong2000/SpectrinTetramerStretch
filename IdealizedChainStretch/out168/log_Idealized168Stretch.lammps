velocity internals scale 310.0

fix printCenters all ave/time 100 200000 20000000 c_endForce file out168/timeAvg_sternForces.${dispRatio}.txt
fix printCenters all ave/time 100 200000 20000000 c_endForce file out168/timeAvg_sternForces.0.01.txt

neighbor 1.0 bin
# comm_modify cutoff 100
neigh_modify every 2000000 delay 2000000 check yes exclude molecule/inter all

run 20000000
