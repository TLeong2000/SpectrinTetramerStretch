variable seed equal 1
units real
boundary p p p

atom_style molecular

region main block -5000 5000 -5000 5000 -5000 5000

create_box 168 main bond/types 167 angle/types 166 extra/bond/per/atom 2 extra/angle/per/atom 3 extra/special/per/atom 6

molecule proto168 prototypeIdealized168.txt
bond_style harmonic
angle_style harmonic

create_atoms 0 single 0 0 0 mol proto168 ${seed} rotate 0 0 0 1

read_data IdealizedCoeffs168.data add merge

group internals type 2:167
group endpoints subtract all internals

fix stationary endpoints setforce 0 0 0

minimize 0.0 1.0e-9 100000 100000

write_dump all custom proto168MinCoords.dump id x y z