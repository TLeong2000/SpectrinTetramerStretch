# fix printCenters all ave/time 100 100000 10000000 c_endForce file out/timeAvg_sternForces.${dispRatio}.txt

variable btwnSamps equal 10000
fix printCenters all ave/time ${btwnSamps} ${btwnSamps} $((v_btwnSamps)^2) c_endForce file diagnostics/timeAvg_sternForces.${dispRatio}.txt
fix printCenters all ave/time 10000 ${btwnSamps} $((v_btwnSamps)^2) c_endForce file diagnostics/timeAvg_sternForces.${dispRatio}.txt
fix printCenters all ave/time 10000 10000 $((v_btwnSamps)^2) c_endForce file diagnostics/timeAvg_sternForces.${dispRatio}.txt
fix printCenters all ave/time 10000 10000 100000000 c_endForce file diagnostics/timeAvg_sternForces.${dispRatio}.txt
fix printCenters all ave/time 10000 10000 100000000 c_endForce file diagnostics/timeAvg_sternForces.0.01.txt

