# variable dispRatio universe 1.00 0.99 0.98 0.97 0.96 0.95 0.90 0.85 0.80 0.75 0.70 0.65 0.60 0.65 0.60 0.55 0.50 0.45 0.40 0.35 0.30 0.25 0.20 0.19 0.18 0.17 0.16 0.15 0.10 0.05 0.04 0.03 0.02 0.01
# variable dispRatio universe 0.01 0.02 0.03 0.04
# variable dispRatio universe 0.99 0.98 0.97 0.96 0.19 0.18 0.17 0.16
 variable dispRatio universe 0.00

log rest_prod_mds/log_HarmonicRestraint84Minimize.lammps
print "The current dispRatio value is ${dispRatio}"

variable totLength equal 1121.3409
variable commDist equal "v_totLength*v_dispRatio"
variable dispDist equal "v_commDist/2"

variable seed equal 1
units real
boundary p p p

atom_style molecular

lattice sc 2500

region main block -1.5 2.5 -0.5 1.5 -1.5 2.5 units lattice
region insertionVolume block -1 2 0 1 -1 2 units lattice

create_box 84 main bond/types 83 angle/types 82 extra/bond/per/atom 2 extra/angle/per/atom 3 extra/special/per/atom 6

molecule productionIdealized productionIdealized84.txt
bond_style harmonic
angle_style harmonic

# Uncomment below if using dispRatio 0.00 OR if NOT using INTEL package
# 
 pair_style none

# Uncomment below if using INTEL package AND NOT using dispRatio 0.00
# 
# pair_style lj/cut 0
# pair_coeff * * 0 0

create_atoms 0 single 0 0 0 mol productionIdealized ${seed} rotate 0 0 0 1

read_data IdealizedCoeffs84.data add merge


group firstAtoms type 1
group lastAtoms type 84
displace_atoms firstAtoms move 0  ${dispDist} 0  units box
displace_atoms lastAtoms move  0 -${dispDist} 0  units box

group endpoints union firstAtoms lastAtoms

compute bondID all property/local btype batom1 batom2
compute angleID all property/local atype aatom1 aatom2 aatom3

fix restraint all arclengthrestraint productionIdealized 0.5 ${totLength}

fix stationary endpoints setforce 0.0 0.0 0.0

comm_modify cutoff 100

minimize 0.0 1.0e-9 100000 100000

unfix stationary


reset_timestep 0

run 0

variable natoms equal count(all)

variable productionFile string "rest_prod_mds/restrained_production_84_${dispRatio}.txt"

print "# Minimized Production Model for dispRatio of ${dispRatio}" file ${productionFile}

print """
$(count(all)) atoms
$(count(all)-1) bonds
$(count(all)-2) angles
0 dihedrals
0 impropers
""" append ${productionFile}

print """

Coords

""" append ${productionFile}
write_dump all custom ${productionFile} id x y z modify append yes header no sort id

print """

Types

""" append ${productionFile}
write_dump all custom ${productionFile} id type modify append yes header no sort id

print """

Molecules

""" append ${productionFile}
write_dump all custom ${productionFile} id mol modify append yes header no sort id

print """

Bonds

""" append ${productionFile}
write_dump all local ${productionFile} index c_bondID[*] modify append yes header no
# write_dump all local ${productionFile} index c_bondID[0] c_bondID[1] c_bondID[2] modify append yes header no sort 2 

print """

Angles

""" append ${productionFile}
# write_dump all local ${productionFile} index c_angleID[0] c_angleID[1] c_angleID[2] c_angleID[3] modify append yes header no sort 2
write_dump all local ${productionFile} index c_angleID[*] modify append yes header no


clear

next dispRatio
jump HarmonicRestraint84Minimize.lammps
