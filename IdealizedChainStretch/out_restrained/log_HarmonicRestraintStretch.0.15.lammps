# For any atom, the difference in the position of that atom with the position
# of the lattice point associated with the molecule it belongs to
# is the same across all molecules
 variable xcenterOne equal $(c_xsumOne/v_napmol)
 variable xcenterOne equal -24000.000000000007276
 variable ycenterOne equal $(c_ysumOne/v_napmol)
 variable ycenterOne equal 5.7520126228198587227e-15
 variable zcenterOne equal $(c_zsumOne/v_napmol)
 variable zcenterOne equal -24000.000000000003638


 variable xoffset equal $(v_xcenterOne - c_xfirstOne)
 variable xoffset equal 124.74529261904899613
 variable yoffset equal $(v_ycenterOne - c_yfirstOne)
 variable yoffset equal 59.050642500000002144
 variable zoffset equal $(v_zcenterOne - c_zfirstOne)
 variable zoffset equal 145.04719966666743858

# We translate all atoms so that the endpoints, before stretching,
# are located at the center of each lattice point,
# which, given how I set up the regions main and insertionVolume,
# is equal to the center of each of the 32 processor subdomains
 displace_atoms all move v_xoffset v_yoffset v_zoffset units box
Displacing atoms ...

# We now re-displace the endpoints
 displace_atoms firstAtoms move 0  ${dispDist} 0  units box
 displace_atoms firstAtoms move 0  84.1005675 0  units box
Displacing atoms ...
 displace_atoms lastAtoms move  0 -${dispDist} 0  units box
 displace_atoms lastAtoms move  0 -84.1005675 0  units box
Displacing atoms ...

# pair_style lj/cut 0
# pair_coeff * * 0 0

# write_dump all custom out_restrained/initPos.${dispRatio}.txt id mol x y z modify sort id
# write_dump all image images/init_restrained.${dispRatio}.png type type zoom 4 adiam 15.0 bond atom 5.0 size 1280 1280


 fix restraint all arclengthrestraint productionIdealized 3.443097561 ${totLength}
 fix restraint all arclengthrestraint productionIdealized 3.443097561 1121.3409

reset_timestep 0

# Set up dynamics
velocity internals create 310.0 ${seed} dist gaussian
velocity internals create 310.0 1 dist gaussian

timestep 100
fix integrate internals nvt temp 310.0 310.0 $(25.0*dt)
fix integrate internals nvt temp 310.0 310.0 2500

compute internalsTemp internals temp
thermo 1000000
thermo_style custom step c_internalsTemp

# compute force in y direction on one of the endpoints
# as the y direction is the direction of displacement
compute endForce lastAtoms reduce ave fy

# compute batomIDs all property/local batom1 batom2
# compute distCalc all bond/local dist dx dy dz

run 0
