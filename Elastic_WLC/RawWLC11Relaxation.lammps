log Out_relaxation/logs/log_Raw_WLC_11_Relaxation.lammps

variable totLength equal 10

variable seed equal 1
units si
boundary p p p

atom_style molecular

region main block -100 100 -100 100 -100 100

create_box 11 main bond/types 10 angle/types 9 extra/bond/per/atom 2 extra/angle/per/atom 3 extra/special/per/atom 6

molecule raw_WLC_11_Atoms Structures/Raw/raw_WLC_11.txt
bond_style harmonic
bond_coeff * 0 1
angle_style harmonic
angle_coeff * 0 180

create_atoms 0 single 0 0 0 mol raw_WLC_11_Atoms ${seed} rotate 0 0 0 1

read_data Structures/Coeffs/coeffs_WLC_11.data add merge


group internals type 2:10
group endpoints subtract all internals


compute bondID all property/local btype batom1 batom2
compute angleID all property/local atype aatom1 aatom2 aatom3

variable k_restrain equal 100

fix restraint all arclengthrestraint raw_WLC_11_Atoms ${k_restrain} ${totLength}



comm_modify cutoff 100

fix stationary endpoints setforce 0 0 0
min_modify dmax 5 norm max
minimize 0.0 0 1000000000 1000000000
unfix stationary

# I have a feeling that setting the force of the endpoints to 0 0 0
# during minimization is preventing the arclengthrestraint fix
# from having the end-to-end arc length reach our desired value
#
# So now, I will try damped dynamics, where time-integration
# is performed only on the internal atoms
#

reset_timestep 0
timestep 1e-9
# fix integrator internals nve/limit 0.01
fix integrator all nve/limit 0.01
fix damper internals viscous 10000
velocity all set 0 0 0
run 0
run 500000000


reset_timestep 0

compute blen all bond/local dist
compute bcomps all bond/local dx dy dz 
compute end2end all reduce sum c_blen inputs local
variable totLen equal c_end2end

compute forces all property/atom fx fy fz
compute sumForces all reduce sum c_forces[1] c_forces[2] c_forces[3]
variable totForce vector c_sumForces

variable validationFile string "Out_relaxation/validation/validation_WLC_11.txt"

run 0

print "# End-to-end arc length following minimization: ${totLen}" file ${validationFile}
write_dump all local ${validationFile} c_blen modify append yes header no
print "" append ${validationFile}
print "# Bond component distances: x y z" append ${validationFile}
write_dump all local ${validationFile} c_bcomps[1] c_bcomps[2] c_bcomps[3] modify append yes header no
print "" append ${validationFile}
print "# Total forces on system following minimization: ${totForce}" append ${validationFile}
write_dump all custom ${validationFile} id fx fy fz modify append yes header no


variable natoms equal count(all)

variable productionFile string "Out_relaxation/relaxed_WLC_11.txt"

print "# Relaxed Production Model for Worm-Like Chain" file ${productionFile}

print """
$(count(all)) atoms
$(count(all)-1) bonds
$(count(all)-2) angles
0 dihedrals
0 impropers
""" append ${productionFile}

print """

Coords

""" append ${productionFile}
write_dump all custom ${productionFile} id x y z modify append yes header no sort id

print """

Types

""" append ${productionFile}
write_dump all custom ${productionFile} id type modify append yes header no sort id

print """

Molecules

""" append ${productionFile}
write_dump all custom ${productionFile} id mol modify append yes header no sort id

print """

Bonds

""" append ${productionFile}
write_dump all local ${productionFile} index c_bondID[*] modify append yes header no
# write_dump all local ${productionFile} index c_bondID[0] c_bondID[1] c_bondID[2] modify append yes header no sort 2 

print """

Angles

""" append ${productionFile}
# write_dump all local ${productionFile} index c_angleID[0] c_angleID[1] c_angleID[2] c_angleID[3] modify append yes header no sort 2
write_dump all local ${productionFile} index c_angleID[*] modify append yes header no
