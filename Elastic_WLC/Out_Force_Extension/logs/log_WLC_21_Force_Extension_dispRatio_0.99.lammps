velocity internals scale 310.0

variable sampFreq equal 10000000 # Sample force on endpoints every this-many timesteps.
variable numSamps equal 100 # Number of force samples to take.
variable numSteps equal "v_sampFreq * v_numSamps"
thermo ${sampFreq}
thermo 10000000

# Print out force on endpoint below
fix printForces all print ${sampFreq} "${computedForce}" file Out_Force_Extension/data/data_WLC_21_dispRatio_$(v_dispRatio:%.2f).txt screen no
fix printForces all print 10000000 "${computedForce}" file Out_Force_Extension/data/data_WLC_21_dispRatio_$(v_dispRatio:%.2f).txt screen no
fix printForces all print 10000000 "${computedForce}" file Out_Force_Extension/data/data_WLC_21_dispRatio_0.99.txt screen no

### Below is for validation purposes ###
compute blen all bond/local dist
compute end2end all reduce sum c_blen inputs local
variable totLen equal c_end2end

variable computedTemp equal c_integrate_temp
# variable sysTemp equal temp
# variable sysKE equal ke

variable validFile_end2end string "Out_Force_Extension/validation/end2end_WLC_21_Force_Extension_dispRatio_$(v_dispRatio:%.2f).txt"
Out_Force_Extension/validation/end2end_WLC_21_Force_Extension_dispRatio_0.99.txt
fix print_end2end all print ${sampFreq} "${totLen}" file ${validFile_end2end} screen no title "End-to-end arc length of WLC with 21 atoms"
fix print_end2end all print 10000000 "${totLen}" file ${validFile_end2end} screen no title "End-to-end arc length of WLC with 21 atoms"
fix print_end2end all print 10000000 "${totLen}" file Out_Force_Extension/validation/end2end_WLC_21_Force_Extension_dispRatio_0.99.txt screen no title "End-to-end arc length of WLC with 21 atoms"

variable validFile_internalsTemp string "Out_Force_Extension/validation/internalsTemp_WLC_21_Force_Extension_dispRatio_$(v_dispRatio:%.2f).txt"
Out_Force_Extension/validation/internalsTemp_WLC_21_Force_Extension_dispRatio_0.99.txt
fix print_internalsTemp all print ${sampFreq} "${computedTemp}" file ${validFile_internalsTemp} screen no title "Temperature (K) of internal atoms of WLC with 21 atoms"
fix print_internalsTemp all print 10000000 "${computedTemp}" file ${validFile_internalsTemp} screen no title "Temperature (K) of internal atoms of WLC with 21 atoms"
fix print_internalsTemp all print 10000000 "${computedTemp}" file Out_Force_Extension/validation/internalsTemp_WLC_21_Force_Extension_dispRatio_0.99.txt screen no title "Temperature (K) of internal atoms of WLC with 21 atoms"
### End of validation block ###


run ${numSteps}
run 1000000000
