unfix stationary

reset_timestep 0
timestep 1e-6

fix integrate internals nvt temp 310.0 310.0 $(10.0*dt)
fix integrate internals nvt temp 310.0 310.0 9.999999999999999124e-06
velocity internals create 310.0 ${seed} dist gaussian
velocity internals create 310.0 1 dist gaussian


compute endForce endpointOmega reduce ave fy # Obtain force on endpoint
variable computedForce equal c_endForce # fix print cannot directly print out computes
thermo_style custom step c_endForce c_integrate_temp temp ke

neighbor 100.0 bin
run 0
WARNING: Communication cutoff 100 is shorter than a bond length based estimate of 101.5. This may lead to errors. (../comm.cpp:730)
