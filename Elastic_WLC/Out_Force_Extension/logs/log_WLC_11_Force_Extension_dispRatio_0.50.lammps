velocity internals scale 310.0

variable sampFreq equal 10000000 # Sample force on endpoints every this-many timesteps.
variable numSamps equal 100 # Number of force samples to take.
variable numSteps equal "v_sampFreq * v_numSamps"
thermo ${sampFreq}
thermo 10000000


dump trajectory all dcd ${sampFreq} Out_Force_Extension/trajectories/WLC_11_dispRatio_$(v_dispRatio:%.2f).dcd
dump trajectory all dcd 10000000 Out_Force_Extension/trajectories/WLC_11_dispRatio_$(v_dispRatio:%.2f).dcd
dump trajectory all dcd 10000000 Out_Force_Extension/trajectories/WLC_11_dispRatio_0.50.dcd

run ${numSteps}
run 1000000000
