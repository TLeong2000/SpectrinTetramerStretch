 unfix stationary

# I have a feeling that setting the force of the endpoints to 0 0 0
# during minimization is preventing the arclengthrestraint fix
# from having the end-to-end arc length reach our desired value
#
# So now, I will try damped dynamics, where time-integration
# is performed only on the internal atoms
#

reset_timestep 0
timestep 1e-6
# min_style fire
# min_modify dmax 10 norm max
# minimize 0 0 1000000 1000000

compute blen all bond/local dist
compute bcomps all bond/local dx dy dz
compute end2end all reduce sum c_blen inputs local
variable totLen equal c_end2end

variable validProgFile string "Out_relaxation/validation/in-progress_validation_WLC_11.txt"
print "" file ${validProgFile}
print "" file Out_relaxation/validation/in-progress_validation_WLC_11.txt

# dump inProgressblen all local 1 ${validProgFile} c_blen
# dump inProgressbcomps all local 1 ${validProgFile} c_bcomps[1] c_bcomps[2] c_bcomps[3]
dump inProgressforces all custom 1 ${validProgFile} id fx fy fz
dump inProgressforces all custom 1 Out_relaxation/validation/in-progress_validation_WLC_11.txt id fx fy fz
fix print_totForce all print 1 "ITEM: Total forces on system at current timestep: ${totForce}" append ${validProgFile}
fix print_totForce all print 1 "ITEM: Total forces on system at current timestep: ${totForce}" append Out_relaxation/validation/in-progress_validation_WLC_11.txt
fix print_end2end all print 1 "ITEM: End-to-end arc length: ${totLen}" append ${validProgFile}
fix print_end2end all print 1 "ITEM: End-to-end arc length: ${totLen}" append Out_relaxation/validation/in-progress_validation_WLC_11.txt
fix newline all print 1 "" append ${validProgFile}
fix newline all print 1 "" append Out_relaxation/validation/in-progress_validation_WLC_11.txt

# dump_modify inProgressblen append yes
# dump_modify inProgressbcomps append yes header no
dump_modify inProgressforces append yes

 fix integrator internals nve
# fix integrator all nve
 fix damper internals viscous 1000
# fix damper all viscous 1
# velocity all set 0 0 0
 run 0
