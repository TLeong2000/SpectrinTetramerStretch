write_dump all custom ${validationFile} id type mol fx fy fz modify append yes header no
write_dump all custom Out_relaxation/validation/validation_WLC_11.txt id type mol fx fy fz modify append yes header no


variable natoms equal count(all)

variable productionFile string "Out_relaxation/relaxed_WLC_11.txt"

print "# Relaxed Production Model for Worm-Like Chain" file ${productionFile}
