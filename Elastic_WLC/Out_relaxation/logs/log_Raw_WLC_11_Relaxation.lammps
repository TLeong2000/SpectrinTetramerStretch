print "# End-to-end arc length following minimization: ${totLen}" file ${validationFile}
print "# End-to-end arc length following minimization: ${totLen}" file Out_relaxation/validation/validation_WLC_11.txt
# End-to-end arc length following minimization: 19.9464114634303
write_dump all local ${validationFile} c_blen modify append yes header no
write_dump all local Out_relaxation/validation/validation_WLC_11.txt c_blen modify append yes header no
print "" append ${validationFile}
print "" append Out_relaxation/validation/validation_WLC_11.txt

print "# Bond component distances: x y z" append ${validationFile}
print "# Bond component distances: x y z" append Out_relaxation/validation/validation_WLC_11.txt
# Bond component distances: x y z
write_dump all local ${validationFile} c_bcomps[1] c_bcomps[2] c_bcomps[3] modify append yes header no
write_dump all local Out_relaxation/validation/validation_WLC_11.txt c_bcomps[1] c_bcomps[2] c_bcomps[3] modify append yes header no
print "" append ${validationFile}
print "" append Out_relaxation/validation/validation_WLC_11.txt

print "# Total forces on system following minimization: ${totForce}" append ${validationFile}
print "# Total forces on system following minimization: ${totForce}" append Out_relaxation/validation/validation_WLC_11.txt
# Total forces on system following minimization: [-43.47593696496838,99.42856957752691,45.20189775096662]
write_dump all custom ${validationFile} id fx fy fz modify append yes header no
write_dump all custom Out_relaxation/validation/validation_WLC_11.txt id fx fy fz modify append yes header no


variable natoms equal count(all)

variable productionFile string "Out_relaxation/relaxed_WLC_11.txt"

print "# Relaxed Production Model for Worm-Like Chain" file ${productionFile}
print "# Relaxed Production Model for Worm-Like Chain" file Out_relaxation/relaxed_WLC_11.txt
# Relaxed Production Model for Worm-Like Chain

print """
$(count(all)) atoms
$(count(all)-1) bonds
$(count(all)-2) angles
0 dihedrals
0 impropers
""" append ${productionFile}
